DATABASE_URL="postgresql://postgres:postgres@localhost:5433/jobtracker"
PORT=3001
# 至少 32 字元；正式環境請用 openssl rand -hex 32 產生
JWT_SECRET="change-me-to-a-random-string-of-at-least-32-chars"
# 次數限制（未設定時用預設值：每 IP 15 分鐘登入 50 次、每 IP 每小時註冊 20 次、同一 email 15 分鐘失敗 5 次）
# 開發時常跑 npm run smoke，可以放寬 IP 的上限：
# LOGIN_LIMIT_PER_IP=1000
# REGISTER_LIMIT_PER_IP=1000
# 每週週報的排程密鑰（至少 32 字元，openssl rand -hex 32）；GitHub Actions 用同一組呼叫 POST /api/cron/weekly-digest。留空代表關閉排程
CRON_SECRET=""
# 週報 Email（Resend，https://resend.com）。留空代表只產生站內週報、不寄信
RESEND_API_KEY=""
# 寄件者；沒有自己的網域時留空，會用 Resend 的測試寄件者 onboarding@resend.dev（只能寄給註冊 Resend 的信箱）
MAIL_FROM=""
# 信裡連結用的網站網址
APP_URL="http://localhost:5173"
