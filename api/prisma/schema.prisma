// 求職追蹤平台的資料表。欄位命名沿用 src/shared/types.ts 的 Job，但只保留追蹤需要的部分。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String?
  createdAt    DateTime      @default(now())
  jobs          Job[]
  applications  Application[]
  refreshTokens RefreshToken[]
}

/// 登入階段。cookie 裡放隨機字串，這裡只存它的 SHA-256；每次換發就作廢舊的、發新的（同一個 familyId）。
/// 已作廢的 token 又被拿來用，代表可能外洩，整個 family 一起作廢。
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model Job {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "taiwanjobs" | "yourator" | "demo" | "manual"
  source      String       @default("manual")
  /// 爬蟲的原始編號（`${source}:編號`），匯入時用來去重
  externalId  String?
  sourceUrl   String?
  title       String
  company     String
  /// RegionId
  region      String?
  address     String       @default("")
  /// JobNature
  nature      String       @default("全職")
  /// Salary.kind
  salaryKind  String       @default("面議")
  salaryMin   Int?
  salaryMax   Int?
  salaryNote  String       @default("")
  skills      String[]     @default([])
  tags        String[]     @default([])
  description String       @default("")
  postedAt    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  application Application?

  @@unique([userId, externalId])
  @@index([userId, createdAt])
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

model Application {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String            @unique
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    ApplicationStatus @default(SAVED)
  appliedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  notes     Note[]
  events    ApplicationEvent[]

  @@index([userId, status])
}

/// 狀態歷程：每次 status 改變記一筆，統計（漏斗、各階段花多久）都從這裡算。fromStatus 為 null 代表剛建立。
model ApplicationEvent {
  id            String             @id @default(cuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  createdAt     DateTime           @default(now())

  @@index([applicationId, createdAt])
}

model Note {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  content       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId, createdAt])
}
