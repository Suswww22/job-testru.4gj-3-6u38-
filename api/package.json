{
  "name": "job-tracker-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "求職追蹤平台後端（Express + Prisma + Postgres）",
  "scripts": {
    "db": "node --use-system-ca scripts/db.mjs",
    "db:stop": "node scripts/db.mjs stop",
    "migrate": "prisma migrate dev",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "smoke": "bash scripts/smoke.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
