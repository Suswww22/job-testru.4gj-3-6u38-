{
  "name": "job-tracker-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "求職追蹤平台前端（React + Vite + TypeScript）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
